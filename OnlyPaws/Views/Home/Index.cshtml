@{
    ViewData["Title"] = "Home Page";
}
@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true"/>
}
<div class="home-content">
    <!--to zrobic w ifa i zeby tylko pokazywalo jak jest ogloszebie -->
    <section class="mt-4 mb-4">
        <div class="announcement-box p-3 d-flex align-items-start gap-3">
            <i class="bi bi-patch-exclamation fs-4"></i>
            <div>
                <h6 class="mb-1 fw-bold">Announcement</h6>
                <p class="mb-0 small">
                    tu bedzie przekazane ogloszenie
                </p>
            </div>
        </div>
    </section>
 
    <section class="d-flex flex-column gap-4">
        <div class="category-card">
            <div class="category-header px-3 py-2 fw-bold">
                <i class="bi bi-stars"></i>
                kat 1
            </div>
            <div class="forum-list">
                <a href="#" class="forum-row d-flex justify-content-between align-items-center p-3 text-decoration-none">
                    <div>
                        <div class="fw-semibold"> tytul forum </div>
                        <div class="small secondary-text"> opis forum </div>
                    </div>
                    <div class="d-flex gap-3 text-center">
                        <div>
                            <div class="fw-bold"> liczba </div>
                            <div class="small secondary-text"> threads </div>
                        </div>

                        <div>
                            <div class="fw-bold"> liczba </div>
                            <div class="small secondary-text"> posts </div>
                        </div>
                    </div>
                </a>
            </div>
        </div>
    </section>
 
</div>