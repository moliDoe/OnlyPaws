@model List<OnlyPaws.Models.Category>
@{
    ViewData["Title"] = "Categories";
}

<!DOCTYPE html>

<html>
<head>
    <title>Categories</title>
</head>
<body>
<div>
    @if (Model.Count == 0)
    {
        <p>no categories yet</p>
    }
    else
    {
        <ul>
            @foreach (var category in Model)
            {
                <li>@category.Name</li>
            }
        </ul>
    }

</div>
</body>
</html>