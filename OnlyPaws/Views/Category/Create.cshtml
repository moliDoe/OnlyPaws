@model OnlyPaws.Models.Category

@{
    ViewData["Title"] = "New Category";
}
@section Styles {
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true"/>
}
<div class="forum-form-card d-flex flex-column">
    <h2 class="mb-1">New Category</h2>
    <p class="secondary-text mb-4">Mark a new territory for pet discussions ♡</p>

    <form asp-action="Create" method="post" class="flex-grow-1 d-flex flex-column">
        <div class="mb-1">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control forum-input" placeholder="Type your category here..."/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        
        <div class="d-flex justify-content-end gap-2 mt-auto">
            <a asp-action="Index" class="btn btn-forum">Cancel</a>
            <button type="submit" class="btn btn-forum">Create</button>
        </div>
    </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
