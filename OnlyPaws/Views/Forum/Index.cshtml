@using Microsoft.EntityFrameworkCore.Metadata.Internal
@model List<OnlyPaws.Models.Forum>

@{
    ViewData["Title"] = "Forums";
}

<h1>Forums</h1>
<div>
    
    @if (Model.Count == 0)
    {
        <p>no forums created yet</p>
    }
    else
    {
        <ul>
            @foreach (var forum in Model)
            {
                <li>@forum.Name</li>
            }
        </ul>
    }

</div>