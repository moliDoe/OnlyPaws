@model OnlyPaws.ViewModels.ForumDetailsViewModel

@{
    ViewData["Title"] = Model.Name;
}

@section Styles {
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true"></link>
}

<div class="forum-details-container mt-4">
    <div class="forum-breadcrumb mb-2">
        <a asp-controller="Home" asp-action="Index">Home</a>
        <span>/</span>
        <a asp-controller="Forum" asp-action="Index">Forums</a>
        <span>/</span>
        <a asp-controller="Forum" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a>
    </div>

    <div class="forum-header-card d-flex justify-content-between align-items-center gap-3 mb-4">

        <div class="forum-info d-flex flex-column gap-2">
            <div class="forum-info-header d-flex flex-row align-items-center gap-2 text-center">
                <h2 class="mb-0 me-2">@Model.Name</h2>
                <p class="category-tag mb-0">@Model.CategoryName</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="secondary-text mb-0">@Model.Description</p>
            }
        </div>
        <div class="forum-counts">
            <div class="forum-stats d-flex gap-2 text-center">
                <div class="stats-label">
                    <div class="fw-bold"> count</div>
                    <div class="stats-text"><i class="bi bi-people-fill"></i></div>
                </div>

                <div class="stats-label">
                    <div class="fw-bold"> @Model.Threads.Count</div>
                    <div class="stats-text"> threads</div>
                </div>

                <div class="stats-label">
                    <div class="fw-bold"> count</div>
                    <div class="stats-text"> posts</div>
                </div>
            </div>
        </div>
    </div>
    <div class="forum-add">
        <a asp-controller="Forum" asp-action="CreateThread" asp-route-forumId="@Model.Id" class="btn btn-forum">
            <i class="bi bi-plus-circle-fill me-2"></i>New Thread
        </a>
    </div>

    @*tu dodanie thread bedzie create kiedys + gdzies isPinned *@
    <div class="threads-list d-flex flex-column gap-2">
        @if (Model.Threads == null || Model.Threads.Count == 0)
        {
            <div class="threads-list-p text-center">
                <p class="secondary-text mb-0">No threads in this forum yet... Start the first one ♡</p>
            </div>
        }
        else
        {
            @foreach (var thread in Model.Threads)
            {
                <!--tu bedzie kontroler forum przekierowujacy na widok thread -->
                <div class="thread-box">
                    <a href="#" class="thread-row d-flex justify-content-between align-items-center">
                        <div>
                            <div class="fw-bold">@thread.Title</div>
                            <div class="thread-author"><i class="bi bi-person-fill"></i>: @thread.AuthorName</div>
                        </div>
                    </a>
                    <div class="thread-stats d-flex gap-4 text-center">
                        <div><i class="bi bi-chat-square-heart-fill me-2"></i>@thread.PostsCount</div>
                        <div><i class="bi bi-eye-fill me-2"></i>@thread.ViewsCount</div>
                    </div>
                </div>
            }
        }
    </div>
</div>