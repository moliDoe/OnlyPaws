@section Styles {
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true"/>
}

<div class="forum-form-card">
    <div class="forum-breadcrumb mb-2">
        <a asp-controller="Home" asp-action="Index">Forum</a>
        <span>/</span>
        <a asp-controller="Forum" asp-action="Threads">PobranaNazwa</a>
        <span>/</span>
        <span>New Thread</span>
    </div>
    <h2 class="mb-1">Start a new thread</h2>
    <p class="secondary-text mb-4">Share your topic with the community ♡</p>

    <form method="post">
        <div class="mb-3">
            <label for="threadTitle" class="form-label">Thread title</label>
            <input id="threadTitle" type="text" class="form-control forum-input" placeholder="What is your thread about?"/>
        </div>

        <div class="mb-4">
            <label for="threadContent" class="form-label">Message</label>
            <textarea id="threadContent" class="form-control forum-input" rows="6" placeholder="Write the opening post here..."></textarea>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-controller="Forum" asp-action="Threads" class="btn btn-forum">Cancel</a>
            <button type="submit" class="btn btn-forum">Create Thread</button>
        </div>
    </form>
</div>