@model OnlyPaws.ViewModels.ForumCreateViewModel

@{
    ViewData["Title"] = "Create";
}

@section Styles {
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true"/>
}

<div class="forum-form-card">
    <h2 class="mb-1">Create a new forum</h2>
    <p class="secondary-text mb-4">Open a new space for our community ♡</p>
    <hr/>

    <form asp-action="Create">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label"></label>
            <input asp-for="Name" class="form-control forum-input" placeholder="Type the forum name here..."/>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Description" class="form-label"></label>
            <input asp-for="Description" class="form-control forum-input" placeholder="Write the description here..."/>
            <span asp-validation-for="Description" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CategoryId" class="form-label"></label>
            <select asp-for="CategoryId" class="form-select forum-input" asp-items="Model.Categories">
                <option value="">Choose category</option>
            </select>
            <span asp-validation-for="CategoryId" class="text-danger"></span>
        </div>
        <div class="mb-1 form-check">
            <label class="form-check-label">
                <input class="form-check-input"
                       asp-for="AllowGuestRead"/> @Html.DisplayNameFor(model => model.AllowGuestRead)
            </label>
        </div>
        <div class="mb-4 form-check">
            <label class="form-check-label">
                <input class="form-check-input"
                       asp-for="AllowGuestWrite"/> @Html.DisplayNameFor(model => model.AllowGuestWrite)
            </label>
        </div>

        <div class="d-flex justify-content-end gap-2">
            <a asp-action="Index" class="btn btn-forum">Cancel</a>
            <button type="submit" class="btn btn-forum">Create</button>
        </div>
    </form>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
